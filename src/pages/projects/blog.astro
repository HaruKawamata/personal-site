---
import SideBannerLayout from "../../layouts/SideBannerLayout.astro"
const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));
---


<SideBannerLayout title="My Blog - Haru Kawamata">
  <header slot="header">
    <h1>ROSASAFI</h1>
    <h2>Reviews of sandwiches and sandwich adjacent food items</h2>
  </header>
  <main>
    <div class="post-grid">
      {
        allPosts.map(
          (post: any, index: number) => (
            <div class="post-cell" style={`background-color: ${index % 2 ? '#333' : '#444'}`}>
              <a href={post.url}>
                <div class="post-image" style={`background-image: url('${post.frontmatter.image.url}')`} />
                <div>
                  <h3>{post.frontmatter.title}</h3>
                  <p>{post.frontmatter.description}</p>
                </div>
              </a>
            </div>
          )
        )
      }
    </div>
  </main>
</SideBannerLayout>

<style>
  .links a {
    text-decoration: none;
  }
  .links img {
    width: 105px;
  }
  .post-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .post-cell {
    margin: 0 0.5rem;
    padding: 0.5rem;
    width: 100%;
  }
  .post-cell a {
    display: flex;
    flex-direction: row;
  }
  .post-image {
    width: 200px;
    height: 150px;
    background-size: cover;
    margin-right: 1rem;
  }
</style>