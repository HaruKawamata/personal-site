---
import SideBannerLayout from "../../layouts/SideBannerLayout.astro"
const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));
---


<SideBannerLayout title="My Blog - Haru Kawamata">
  <header slot="header">
    <h1>ROSASAFI</h1>
    <h2>Reviews of sandwiches and sandwich adjacent food items</h2>
  </header>
  <main>
    <div class="post-grid">
      {
        allPosts.map(
          (post: any) => (
            <div class="post-cell">
              <a href={post.url}>
                <img src={post.frontmatter.image.url} />
                <p>{post.frontmatter.title}</p>
                <p>{post.frontmatter.description}</p>
              </a>
            </div>
          )
        )
      }
    </div>
  </main>
</SideBannerLayout>

<style>
  .links a {
    text-decoration: none;
  }
  .links img {
    width: 105px;
  }
  .post-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .post-cell {
    display: flex;
    flex-direction: column;
    margin: 0 0.5rem;
    width: 200px;
  }
  .post-cell img {
    width: 100%;
  }
</style>