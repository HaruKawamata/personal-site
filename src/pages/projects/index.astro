---
import SideBannerLayout from "../../layouts/SideBannerLayout.astro"

import clockblockerCellImage from "@images/projects/clockblocker-screenshot.png"
import hierarchyCellImage from "@images/projects/hierarchy.png"
import isseiCellImage from "@images/projects/issei-cell.png"

import webAppMicroBanner from "@images/buttons/clockblocker-app.png"
import githubMicroBanner from "@images/buttons/github.png"

import redditMicroBanner from "@images/buttons/reddit.png"
import kickstarterMicroBanner from "@images/buttons/kickstarter.png"
import shopPageMicroBanner from "@images/buttons/button-shy.png"

import githubServerMicroBanner from "@images/buttons/github-server.png"
import githubAppMicroBanner from "@images/buttons/github-app.png"

import utenaNotesMicroBanner from "@images/buttons/utena-notes.png"

import utenaFansubNavIcon from "@images/nav/utena-fansub.png"
import clockblockerNavIcon from "@images/nav/clockblocker.png"
import hierarchyNavIcon from "@images/nav/hierarchy.png"
import isseiNavIcon from "@images/nav/issei.png"
---


<SideBannerLayout title="Projects - Haru Kawamata">
  <header slot="header">
    <h1>Projects</h1>
    <h2>View my featured projects and other links</h2>
  </header>
  <main>
    <div class="project-table">
      <div class="project-cell">
        <h3>Utena Fansub</h3>
        <a href="/projects/utena-fansub">
          <img class="micro-banner" src={utenaFansubNavIcon.src} alt="Projects/Utena Fansub Nav" />
        </a>
        <a href="/projects/utena-fansub">
          <img class="cell-image" src="/images/posts/japanese-english-pronouns/utena.jpg" alt="A screencap of Utena from Revolutionary Girl Utena, framed by wrought-iron rose stems" />
        </a>
        <div class="other-links">
          <a href="/blog/utena-fansub">
            <img src={utenaNotesMicroBanner.src} alt="Link to all Utena fansub translation notes" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Clockblocker</h3>
        <a href="/projects/clockblocker">
          <img class="micro-banner" src={clockblockerNavIcon.src} alt="Projects/Clockblocker Nav" />
        </a>
        <a href="/projects/clockblocker">
          <img class="cell-image" src={clockblockerCellImage.src} alt="A screenshot from Clockblocker, a time management webapp" />
        </a>
        <div class="other-links">
          <a href="https://clockblocker.netlify.app/">
            <img src={webAppMicroBanner.src} alt="Link to the clockblocker site" />
          </a>
          <a href="https://github.com/HaruKawamata/clockblocker">
            <img src={githubMicroBanner.src} alt="Link to the clockblocker github repo" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Hierarchy</h3>
        <a href="/projects/hierarchy">
          <img class="micro-banner" src={hierarchyNavIcon.src} alt="Projects/Hierarchy Nav" />
        </a>
        <a href="/projects/hierarchy">
          <img class="cell-image" src={hierarchyCellImage.src} alt="A photo of my card game, Hierarchy" />
        </a>
        <div class="other-links">
          <a href="https://www.reddit.com/r/boardgames/comments/ahv6st/check_out_hierarchy_a_printable_simple_14_card/">
            <img src={redditMicroBanner.src} alt="Link to Original Reddit post" />
          </a>
          <a href="https://www.kickstarter.com/projects/239309591/hierarchy-an-abstract-game-of-order-and-power">
            <img src={kickstarterMicroBanner.src} alt="Link to Funded Kickstarter" />
          </a>
          <a href="https://buttonshygames.com/products/hierarchy">
            <img src={shopPageMicroBanner.src} alt="Link to Buy Hierarchy" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Issei</h3>
        <a href="/projects/issei">
          <img class="micro-banner" src={isseiNavIcon.src} alt="Projects/Issei Nav" />
        </a>
        <a href="/projects/issei">
          <img class="cell-image" src={isseiCellImage.src} alt="A screenshot from Issei, my Japanese language app" />
        </a>
        <div class="other-links">
          <a href="https://www.kickstarter.com/projects/239309591/hierarchy-an-abstract-game-of-order-and-power">
            <img src={githubServerMicroBanner.src} alt="Link to GitHub repo of Issei's server and DB" />
          </a>
          <a href="https://buttonshygames.com/products/hierarchy">
            <img src={githubAppMicroBanner.src} alt="Link to GitHub repo of Issei's React Native application" />
          </a>
        </div>
      </div>
    </div>
  </main>
</SideBannerLayout>

<style>
  .other-links {
    display: flex;
    justify-content: space-between;
  }
  .other-links img {
    width: 90px;
  }
  .micro-banner {
    width: 90px;
  }
  .project-cell a {
    text-decoration: none;
  }
  .project-table {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .project-cell {
    display: flex;
    flex-direction: column;
    margin: 0 0.5rem;
  }
  .cell-image {
    width: 19rem;
  }

  @media (max-width: 767px) {
    .cell-image {
      width: 100%;
    }
  }
</style>
