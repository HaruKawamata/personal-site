---
import SideBannerLayout from "../../layouts/SideBannerLayout.astro"

import blogCellImage from "@images/projects/blog-cell.png"
import clockblockerCellImage from "@images/projects/clockblocker-screenshot.png"
import hierarchyCellImage from "@images/projects/hierarchy.png"
import isseiCellImage from "@images/projects/issei-cell.png"

import blogAllPostsMicroBanner from "@images/buttons/blog-all-posts.png"
import blogLangblrMicroBanner from "@images/buttons/blog-langblr.png"
import blogMyArtMicroBanner from "@images/buttons/blog-my-art.png"

import webAppMicroBanner from "@images/buttons/clockblocker-app.png"
import githubMicroBanner from "@images/buttons/github.png"

import redditMicroBanner from "@images/buttons/reddit.png"
import kickstarterMicroBanner from "@images/buttons/kickstarter.png"
import shopPageMicroBanner from "@images/buttons/button-shy.png"

import githubServerMicroBanner from "@images/buttons/github-server.png"
import githubAppMicroBanner from "@images/buttons/github-app.png"

import blogNavIcon from "@images/nav/blog.png"
import clockblockerNavIcon from "@images/nav/clockblocker.png"
import hierarchyNavIcon from "@images/nav/hierarchy.png"
import isseiNavIcon from "@images/nav/issei.png"
---


<SideBannerLayout title="Projects - Haru Kawamata">
  <header slot="header">
    <h1>Projects</h1>
    <h2>View my featured projects and other links</h2>
  </header>
  <main>
    <div class="project-table">
      <div class="project-cell">
        <h3>My Blog</h3>
        <a href="/projects/blog">
          <img class="micro-banner" src={blogNavIcon} alt="Projects/Blog Nav" />
        </a>
        <a href="/projects/blog">
          <img class="cell-image" src={blogCellImage} alt="A screenshot from my blog" />
        </a>
        <div class="other-links">
          <a href="https://haru-dipthong.tumblr.com/tagged/official%20blog%20post">
            <img src={blogAllPostsMicroBanner} alt="Link to all original blog posts" />
          </a>
          <a href="https://haru-dipthong.tumblr.com/tagged/langblr">
            <img src={blogLangblrMicroBanner} alt="Link to all linguistics blog posts" />
          </a>
          <a href="https://haru-dipthong.tumblr.com/tagged/my%20art">
            <img src={blogMyArtMicroBanner} alt="Link to all original art blog posts" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Clockblocker</h3>
        <a href="/projects/clockblocker">
          <img class="micro-banner" src={clockblockerNavIcon} alt="Projects/Clockblocker Nav" />
        </a>
        <a href="/projects/clockblocker">
          <img class="cell-image" src={clockblockerCellImage} alt="A screenshot from Clockblocker, a time management webapp" />
        </a>
        <div class="other-links">
          <a href="https://clockblocker.netlify.app/">
            <img src={webAppMicroBanner} alt="Link to the clockblocker site" />
          </a>
          <a href="https://github.com/HaruKawamata/clockblocker">
            <img src={githubMicroBanner} alt="Link to the clockblocker github repo" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Hierarchy</h3>
        <a href="/projects/hierarchy">
          <img class="micro-banner" src={hierarchyNavIcon} alt="Projects/Hierarchy Nav" />
        </a>
        <a href="/projects/hierarchy">
          <img class="cell-image" src={hierarchyCellImage} alt="A photo of my card game, Hierarchy" />
        </a>
        <div class="other-links">
          <a href="https://www.reddit.com/r/boardgames/comments/ahv6st/check_out_hierarchy_a_printable_simple_14_card/">
            <img src={redditMicroBanner} alt="Link to Original Reddit post" />
          </a>
          <a href="https://www.kickstarter.com/projects/239309591/hierarchy-an-abstract-game-of-order-and-power">
            <img src={kickstarterMicroBanner} alt="Link to Funded Kickstarter" />
          </a>
          <a href="https://buttonshygames.com/products/hierarchy">
            <img src={shopPageMicroBanner} alt="Link to Buy Hierarchy" />
          </a>
        </div>
      </div>
      <div class="project-cell">
        <h3>Issei</h3>
        <a href="/projects/issei">
          <img class="micro-banner" src={isseiNavIcon} alt="Projects/Issei Nav" />
        </a>
        <a href="/projects/issei">
          <img class="cell-image" src={isseiCellImage} alt="A screenshot from Issei, my Japanese language app" />
        </a>
        <div class="other-links">
          <a href="https://www.kickstarter.com/projects/239309591/hierarchy-an-abstract-game-of-order-and-power">
            <img src={githubServerMicroBanner} alt="Link to GitHub repo of Issei's server and DB" />
          </a>
          <a href="https://buttonshygames.com/products/hierarchy">
            <img src={githubAppMicroBanner} alt="Link to GitHub repo of Issei's React Native application" />
          </a>
        </div>
      </div>
    </div>
  </main>
</SideBannerLayout>

<style>
  .other-links {
    display: flex;
    justify-content: space-between;
  }
  .other-links img {
    width: 90px;
  }
  .micro-banner {
    width: 90px;
  }
  .project-cell a {
    text-decoration: none;
  }
  .project-table {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .project-cell {
    display: flex;
    flex-direction: column;
    margin: 0 0.5rem;
  }
  .cell-image {
    width: 19rem;
  }

  @media (max-width: 767px) {
    .cell-image {
      width: 100%;
    }
  }
</style>
