---
import SideBannerLayout from "../../layouts/SideBannerLayout.astro"
import { blogTags } from "../../data/blogTags"

export function getStaticPaths() {
  return blogTags.map((blogTag) => ({ params: { tag: blogTag.path }, props: { blogTag } }))
}

const { blogTag } = Astro.props
const allPosts: any[] = Object.values(import.meta.glob('../posts/*.md', { eager: true }))
const posts = allPosts
  .filter((post) => blogTag.tag === null || post.frontmatter.tags?.includes(blogTag.tag))
  .sort((a, b) => {
    if (a.frontmatter.pubDate > b.frontmatter.pubDate) {
      return -1
    } else {
      return 1
    }
  })
---


<SideBannerLayout title={`${blogTag.title} - Haru Kawamata`}>
  <header slot="header">
    <h1>{blogTag.title}</h1>
    <h2>{blogTag.description}</h2>
  </header>
  <main>
    <div class="post-grid">
      {posts.length === 0 && <p>No posts yet.</p>}
      {
        posts.map(
          (post: any, index: number) => (
            <div class="post-cell" style={`background-color: ${index % 2 ? '#333' : '#444'}`}>
              <a href={post.url}>
                <div class="post-image" style={`background-image: url('${post.frontmatter.image.url}')`} />
                <div>
                  <h3>{post.frontmatter.title}</h3>
                  <p>{post.frontmatter.description}</p>
                </div>
              </a>
            </div>
          )
        )
      }
    </div>
  </main>
</SideBannerLayout>

<style>
  .post-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .post-cell {
    margin: 0 0.5rem;
    padding: 0.5rem;
    width: 100%;
  }
  .post-cell a {
    display: flex;
    flex-direction: row;
  }
  .post-image {
    width: 200px;
    height: 150px;
    background-size: contain;
    background-repeat: no-repeat;
    margin-right: 1rem;
  }
</style>
