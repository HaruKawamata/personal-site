---
import blogBannerAd from "@images/banners/blog.png"
import hierarchyBannerAd from "@images/banners/hierarchy.gif"
import clockblockerBannerAd from "@images/banners/clockblocker.gif"
import utenaBannerAd from "@images/banners/utena.png"
const bannerAds = [
  { src: blogBannerAd.src, link: "https://harukawamata.com/blog/" },
  { src: hierarchyBannerAd.src, link: "https://buttonshygames.com/products/hierarchy" },
  { src: clockblockerBannerAd.src, link: "https://clockblocker.netlify.app/" },
  { src: utenaBannerAd.src, link: "https://harukawamata.com/projects/utena-fansub/" },
]

// Picked at build time so there's still a banner without JavaScript; the script below re-rolls on every page load
const buildTimeAd = bannerAds[Math.floor(Math.random() * bannerAds.length)]
---
<!-- Can't call the class or image "banner-ad" or it gets yoinked by adblock lol -->
<div class="image-link">
  <a href={buildTimeAd.link}>
    <img src={buildTimeAd.src} alt="A fake retro banner" />
  </a>
</div>
<!-- Runs inline, straight after the banner, so it swaps before the page is painted -->
<script is:inline define:vars={{ bannerAds }}>
  const banner = document.currentScript.previousElementSibling.querySelector("a")
  const ad = bannerAds[Math.floor(Math.random() * bannerAds.length)]
  banner.href = ad.link
  banner.querySelector("img").src = ad.src
</script>

<style>
  .image-link img {
    width: 137px;
  }
  
  @media (max-width: 767px) {
    .image-link img {
      width: 70px;
      margin-left: 1rem;
    }
  }
</style>