---
import PlainMarkdownPostLayout from "./PlainMarkdownPostLayout.astro"
const { frontmatter } = Astro.props;
const backLink = frontmatter.backLink ?? { href: "/blog/utena-fansub", label: "Back to Utena fansub notes" }
---
<PlainMarkdownPostLayout frontmatter={frontmatter} backLink={backLink}>
  <slot />
</PlainMarkdownPostLayout>

<!-- Highlight colours that pair Japanese lines with their translations (Tumblr's text palette) -->
<style is:global>
.color-red {
  color: #ff4930;
}
.color-orange {
  color: #ff8a00;
}
.color-green {
  color: #00cf35;
}
.color-blue {
  color: #00b8ff;
}
.color-purple {
  color: #7c5cff;
}
.color-pink {
  color: #ff62ce;
}
.youtube-embed {
  width: 100%;
  max-width: 640px;
  aspect-ratio: 16 / 9;
}
</style>
