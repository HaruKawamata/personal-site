---
import ParahumansSideNav from "../components/ParahumansSideNav.astro"
import BannerAd from "../components/BannerAd.astro";
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <ParahumansSideNav />
    <content>
      <div class="documentTabs">
        <div class="documentTab"><strong>article</strong></div>
        <div class="documentTab">discussion</div>
        <div class="documentTab">edit this page</div>
        <div class="documentTab">history</div>
      </div>
      <div class="article">
        <h1>
          <slot name="title">
        </h1>
        <slot />
      </div>
    </content>
  </body>
</html>
<style is:global>
  :root {
    --accent: 124, 58, 237;
    --accent-gradient: linear-gradient(45deg, rgb(var(--accent)), #da62c4 30%, white 60%);
  }
  html {
    background-color: #F0F0F0;
    color: #202122;
    font-family: "Helvetica", sans-serif;
  }
  header {
    text-align: center;
  }
  body {
    margin: 0 0 1rem 0;
    display: flex;
    justify-content: space-between;
  }
  a {
    color: #3366CC;
  }
  a:visited:not(.neverVisited) {
    color: #795CB2;
  }
  .redLink {
    color: #BF3C2D;
  }
  content {
    flex-grow: 1;
    margin-top: 1rem;
  }
  h1 {
    border-bottom: 1px solid #BBBBBB;
    width: 100%;
  }
  .documentTabs {
    display: flex;
    flex-direction: row;
  }
  .documentTab {
    border: 1px solid #999999;
    border-bottom: none;
    background-color: #FFFFFF;
    margin-right: 1rem;
  }
  .article {
    background-color: #FFFFFF;
    min-height: 400px;
    padding: 1rem;
    padding-bottom: 3rem;
    border: 1px solid #999999;
    border-top: none;
  }
  .warning {
    background-color: #FFB3B3;
    color: red;
    padding: 1rem;
  }
  .helpExpand {
    background-color: #B3D2FF;
    color: blue;
    padding: 1rem;
  }
  .helpExpand ul {
    margin: 0;
  }
</style>
