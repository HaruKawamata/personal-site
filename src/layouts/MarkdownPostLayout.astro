---
import SideBannerLayout from './SideBannerLayout.astro';
const { frontmatter } = Astro.props;
---
<SideBannerLayout title={frontmatter.title}>
  <header slot="header">
    <h1>{frontmatter.title}</h1>
    <h2>{frontmatter.description}</h2>
  </header>
  <main>
    <div class="post-image" style={`background-image: url('${frontmatter.image.url}')`} />
    <slot />
    <p>Location: {frontmatter.mapsLink}
  </main>
</SideBannerLayout>

<style>
  .post-image {
    width: 400px;
    height: 300px;
    background-size: cover;
  }
</style>